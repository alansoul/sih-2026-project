{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": "./",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "jsx": "react-jsx",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "paths": {
      "@my-sih-project/types": [
        "packages/shared/types/src/index.ts"
      ],
      "@my-sih-project/shared-ui": [
        "packages/shared/ui/src/index.ts"
      ],
      "@my-sih-project/feature-analytics": [
        "packages/screening/feature-analytics/src/index.ts"
      ],
      "@my-sih-project/feature-scanner": [
        "packages/screening/feature-scanner/src/index.ts"
      ],
      "@my-sih-project/feature-forensics": [
        "packages/screening/feature-forensics/src/index.ts"
      ],
      "@my-sih-project/feature-audit-trail": [
        "packages/screening/feature-audit-trail/src/index.ts"
      ],
      "@my-sih-project/screening-data-access": [
        "packages/screening/data-access/src/index.ts"
      ],
      "@org/api-products": [
        "packages/api/products/src/index.ts"
      ],
      "@org/shared-models": [
        "packages/shared/models/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}